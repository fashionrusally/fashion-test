---
const { title, text } = Astro.props;
---

<div class="card">
  <h4>{title}</h4>
  <p>{text}</p>
</div>

<style>
  .card { background:#8b0f00; color:#fff; padding:1.5rem; width:280px; border-radius:8px; box-shadow:0 6px 0 rgba(0,0,0,0.1); }
  .card h4 { margin-top:0; }

  @media (max-width:800px) {
    .card { width:100%; max-width:340px; }
  }
</style>
