---
const { product } = Astro.props;

---

<article class="pcard">
    <img class="pcard-image" src={`https://kea-alt-del.dk/t7/images/webp/640/${product.id}.webp`} alt={product.productdisplayname} />
    <div class="pcard-content">
        <h3>{product.productdisplayname}</h3>
        <p class="price">kr.{product.price},-</p>
    </div>
</article>


<style>
    .pcard {
        display: flex;
        gap: 1rem;
        align-items: center;
        border: 2px solid #111;
        padding: 12px;
        background: #fff;
        border-radius: 8px;
    }

    .pcard-image {
        width: 40%;
        height: auto;
        object-fit: cover;
        border-radius: 6px;
    }

    .pcard-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-end; /* place text on the right */
        text-align: right;
    }

    .pcard-content h3 {
        margin: 0 0 0.5rem 0;
        font-size: 1.05rem;
    }

    .price {
        margin: 0;
        font-weight: 700;
        color: #8b0f00;
    }

    @media (max-width: 600px) {
        .pcard { flex-direction: column; align-items: flex-start; }
        .pcard-content { align-items: flex-start; text-align: left; }
        .pcard-image { width: 100%; }
    }
</style>