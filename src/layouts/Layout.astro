</html>

<style>
	html,
	body {
font-family: 'Courier New', Courier, monospace;
	margin: 0;
	padding: 0;
}

.hero-section {
	min-height: 60vh;
	background-image: var(--hero-image);
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	color: #fff;
	margin-top: -64px;
	padding: 6rem 1rem 4rem 1rem;
}

nav {
	height: 64px;
	display: flex;
	align-items: center;
	padding: 0 1rem;
	position: relative;
	z-index: 10;
}

body.has-hero nav {
	background: transparent;
}

nav a {
	color: inherit;
	text-decoration: none;
	margin-right: 1rem;
}

h1 {
	color: inherit;
}

.site-footer {
	background: #A50202;
	color: #fff;
	padding: 4rem 2rem;
}
.footer-inner {
	max-width: 1200px;
	margin: 0 auto;
	display: flex;
	justify-content: space-between;
	gap: 2rem;
	align-items: flex-start;
}
.footer-left { flex: 1 1 60%; 
}
.footer-brand { 
	font-size: 5rem;
	margin: 0 0 1rem 0; 
	font-weight: 800; 
	letter-spacing: 1px; 
}
.footer-hr { width: 70%; 
	height: 4px; 
	background: #fff; 
	border: none; 
	margin: 1rem 0 1.25rem 0; }
.footer-address p { 
	margin: 0.25rem 0;
	opacity: 0.95; 
}
.footer-right { 
	flex: 0 0 320px; 
}
.footer-right h3 { 
	margin: 0 0 0.75rem 0; 
	font-size: 1.25rem; 
}
.footer-right p { 
	margin: 0 0 0.75rem 0; 
	line-height: 1.5; 
}
.open-hours { 
	font-weight: 700; 
	margin-top: 0.5rem; 
}

@media (max-width:1000px) {
	.footer-inner { flex-direction: column; align-items: flex-start; }
	.footer-brand { font-size: 3rem; }
	.footer-right { width:100%; }
}
</style>
